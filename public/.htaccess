# Réécriture : toutes les requêtes (hors fichiers existants) → index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Empêche l'accès direct aux fichiers sensibles éventuellement déposés ici.
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# Réécriture : toutes les requêtes (hors fichiers réels) → index.php.
# Volontairement PAS de "RewriteCond %{REQUEST_FILENAME} !-d" : un dossier
# parasite qui apparaîtrait un jour dans public/ (dépôt manuel, ancien
# déploiement, etc.) ne doit jamais pouvoir intercepter une route de
# l'application avant le routeur PHP — seuls de vrais fichiers (CSS/JS/
# uploads) sont servis directement.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Empêche l'accès direct aux fichiers sensibles éventuellement déposés ici.
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

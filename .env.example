# =============================================================================
#  Keepnew Booking — variables d'environnement (exemple)
#  Copier en .env HORS webroot. Ne JAMAIS committer .env.
# =============================================================================

APP_ENV=production              # production | staging | local
APP_DEBUG=false
APP_URL=https://booking.keepnew.be
APP_TIMEZONE_DISPLAY=Europe/Brussels
APP_KEY=                        # clé aléatoire 32+ octets (signatures de tokens)

# --- Base de données (PDO MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keepnew
DB_USER=keepnew
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- SMTP (PHPMailer) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@keepnew.be
MAIL_FROM_NAME="Keepnew"

# --- SMS (abstraction SmsProviderInterface) ---
SMS_PROVIDER=none               # none | twilio | brevo
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
BREVO_API_KEY=
BREVO_SENDER=

# --- Cartographie (GeoProviderInterface) ---
GEO_PROVIDER=ors                # ors | google  (repli interne : postal_matrix)
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Paiement (PaymentGatewayInterface) — inactif au lancement ---
PAYMENT_GATEWAY=null            # null | mollie | stripe
MOLLIE_API_KEY=
STRIPE_SECRET_KEY=

# --- Sécurité anti-spam ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tracking ---
GA4_MEASUREMENT_ID=
META_CAPI_PIXEL_ID=
META_CAPI_TOKEN=
GOOGLE_ADS_CONVERSION_ID=

# --- Peppol (facturation B2B UBL BIS 3.0) ---
PEPPOL_ACCESS_POINT_URL=
PEPPOL_API_KEY=
